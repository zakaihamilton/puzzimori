{
  "name": "puzzimori",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "health": "repnix check",
    "health:dead-code": "knip",
    "health:architecture": "depcruise --output-type json --config .dependency-cruiser.cjs -- src",
    "audit:dependencies": "pnpm audit --audit-level high",
    "verify": "pnpm health && pnpm audit:dependencies && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.4.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "knip": "6.38.0",
    "prettier": "3.9.9",
    "repnix": "1.0.3",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
