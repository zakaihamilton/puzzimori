{
  "name": "puzzimori",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "health": "repnix check",
    "health:dead-code": "knip",
    "health:architecture": "depcruise --output-type json --config .dependency-cruiser.cjs -- src",
    "audit:dependencies": "pnpm audit --audit-level high",
    "verify": "pnpm health && pnpm audit:dependencies && pnpm build && pnpm test:e2e",
    "health:a11y": "pnpm build && playwright test tests/guardrails.spec.ts --project=desktop",
    "health:visual": "if [ \"$RUN_VISUAL_REGRESSION\" = \"1\" ] || [ \"$(uname)\" = \"Darwin\" ]; then pnpm build && playwright test tests/guardrails.spec.ts --project=desktop; else echo \"Visual regression runs in the macOS guardrail job.\"; fi",
    "health:interactions": "vitest run tests/ui/user-interactions.test.tsx",
    "health:styles": "stylelint --formatter json \"**/*.{css,pcss,postcss}\""
  },
  "dependencies": {
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.7",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "knip": "6.38.0",
    "prettier": "3.9.9",
    "repnix": "^1.1.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2",
    "@axe-core/playwright": "^4.13.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^26.1.0",
    "stylelint": "^17.11.1",
    "stylelint-config-standard": "^40.0.0"
  }
}
