{
  "name": "puzzimori",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "health": "repnix check",
    "health:dead-code": "knip --reporter json",
    "health:architecture": "depcruise --output-type json --config .dependency-cruiser.cjs -- src",
    "audit:dependencies": "npm audit --audit-level=high",
    "verify": "npm run health && npm run health:styles && npm run audit:dependencies && npm run build && npm run test:e2e",
    "health:a11y": "npm run build && npm exec -- playwright test tests/guardrails.spec.ts --project=desktop --grep=WCAG",
    "health:visual": "if [ \"$RUN_VISUAL_REGRESSION\" = \"1\" ] || [ \"$(uname)\" = \"Darwin\" ]; then npm run build && npm exec -- playwright test tests/guardrails.spec.ts --project=desktop; else echo \"Visual regression runs in the macOS guardrail job.\"; fi",
    "health:interactions": "vitest run tests/ui/user-interactions.test.tsx",
    "health:styles": "find src -type f -name '*.css' -print0 | xargs -0 biome lint"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.4.0",
    "jsdom": "^26.1.0",
    "knip": "6.38.0",
    "repnix": "^1.1.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  }
}
